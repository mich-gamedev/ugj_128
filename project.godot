[audio]

buses/default_bus_layout="uid://m67tbvqdwg33"

[autoload]

Cursor="*uid://d1qrewxpucjcs"
PauseMenu="*uid://dh05oskgcqqdw"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/StyleboxFancy/plugin.cfg", "res://addons/Todo_Manager/plugin.cfg", "res://addons/fancy_folder_icons/plugin.cfg", "res://addons/quick_notes_dock/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[global_group]

hook=""

[gui]

common/snap_controls_to_pixels=false
theme/custom="uid://crwh0s0onq4n5"
theme/custom_font="uid://ssvwv7airuao"

